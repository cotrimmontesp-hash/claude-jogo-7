{
  "expo": {
    "name": "Sombra de Vila Rica",
    "slug": "claude-jogo-7",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#120d08",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.claude.sombravilarica",
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS", "INTERNET"]
    },
    "ios": {
      "bundleIdentifier": "com.claude.sombravilarica",
      "infoPlist": { "NSMicrophoneUsageDescription": "Usado para a chamada de voz com seu grupo." }
    },
    "web": { "bundler": "metro", "output": "single", "name": "Sombra de Vila Rica", "display": "fullscreen", "orientation": "landscape" },
    "plugins": ["expo-screen-orientation"]
  }
}
